# =================================================================
# QAgent — Production & Development Environment Configuration
# =================================================================

PROJECT_NAME="QAgent — Agentic AI Question Generator"
VERSION="1.0.0"

# Environment Mode ("production" or "development")
ENVIRONMENT=production

# Demo Data Seeding (Set to false for fresh production)
SEED_DEMO_DATA=false

# =================================================================
# Database Configuration
# =================================================================
# Production Neon PostgreSQL (Connection Pooling Enabled). REQUIRED when
# ENVIRONMENT=production: the app refuses to start without it, and refuses a
# SQLite URL, rather than silently writing to an ephemeral container disk.
DATABASE_URL=postgresql+asyncpg://neondb_owner:YourSecurePassword@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Development SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/academic_rag.db

# =================================================================
# File & Object Storage Configuration
# =================================================================
# Options: "local" (Filesystem) or "s3" (AWS S3 / MinIO / Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_DIR=./data/uploads
EXPORTS_DIR=./data/exports

# S3 Configuration (Required if STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=qagent-academic-storage
S3_REGION=us-east-1

# Vector Store Provider ("local" or "pgvector")
VECTOR_STORE_PROVIDER=local
VECTOR_STORAGE_DIR=./data/vector_store

# =================================================================
# AI / LLM Gateway — OpenRouter (Primary Provider)
# =================================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://qagent-frontend-jxvh.vercel.app
OPENROUTER_APP_NAME=QAgent

# Alternative Direct NVIDIA NIM Provider (Optional)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional Local Offline Fallback (Development only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# =================================================================
# Security & JWT Authentication
# =================================================================
# JWT signing key. Generate with: openssl rand -hex 32
# No default ships in source. If this is unset the service generates a random
# key at boot, which is safe but invalidates every issued token on restart --
# always set it explicitly in production.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated or JSON list). The production frontend
# origin is always included; this adds to it.
CORS_ORIGINS=["https://qagent-frontend-jxvh.vercel.app", "http://localhost:5173"]

# Regex for additional allowed origins. The default admits Vercel preview
# deployments of the qagent projects only, not every *.vercel.app site.
# CORS_ORIGIN_REGEX=^https://qagent[a-z0-9._-]*\.vercel\.app$

# Diagnostic endpoints (/debug/*, /api/debug/*) enumerate the route table and
# name the database host, so they return 404 in production. Set to "true" only
# for a temporary investigation.
# ENABLE_DIAGNOSTICS=false

# =================================================================
# RAG & Multi-Agent Tunables
# =================================================================
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
SIMILARITY_DUPLICATE_THRESHOLD=0.82
MAX_REVISION_ATTEMPTS=3

# =================================================================
# Frontend (Vite) — set in the Vercel project, NOT here
# =================================================================
# Only VITE_-prefixed variables reach the browser bundle, so never put a
# backend secret behind this prefix.
# VITE_API_BASE_URL=https://qagent-production.onrender.com
