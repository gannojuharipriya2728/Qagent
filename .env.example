# =================================================================
# QAgent — Production & Development Environment Configuration
# =================================================================

PROJECT_NAME="QAgent — Agentic AI Question Generator"
VERSION="1.0.0"

# Environment Mode ("production" or "development")
ENVIRONMENT=production

# Demo Data Seeding (Set to false for fresh production)
SEED_DEMO_DATA=false

# =================================================================
# Database Configuration
# =================================================================
# Production PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@localhost:5432/qagent_db
# Development SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/academic_rag.db

# =================================================================
# File & Object Storage Configuration
# =================================================================
# Options: "local" (Filesystem) or "s3" (AWS S3 / MinIO / Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_DIR=./data/uploads
EXPORTS_DIR=./data/exports

# S3 Configuration (Required if STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=qagent-academic-storage
S3_REGION=us-east-1

# Vector Store Provider ("local" or "pgvector")
VECTOR_STORE_PROVIDER=local
VECTOR_STORAGE_DIR=./data/vector_store

# =================================================================
# AI / LLM Gateway — OpenRouter (NVIDIA Nemotron 3.5 Lightning)
# =================================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://youruniversity.edu
OPENROUTER_APP_NAME=QAgent

# Optional Local Offline Fallback (Development only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# =================================================================
# Security & JWT Authentication
# =================================================================
# Generate a secure 64-char secret: openssl rand -hex 32
SECRET_KEY=your-production-secret-key-at-least-32-chars-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://youruniversity.edu", "http://localhost:5173"]

# =================================================================
# RAG & Multi-Agent Tunables
# =================================================================
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
SIMILARITY_DUPLICATE_THRESHOLD=0.82
MAX_REVISION_ATTEMPTS=3
